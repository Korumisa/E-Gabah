# Salin ke .env.local dan isi nilainya.
# cp .env.example .env.local

# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Cloudinary — Settings → Product environment + Upload presets (Unsigned)
# Jangan taruh CLOUDINARY_API_SECRET di VITE_* (hanya server/edge).
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
VITE_CLOUDINARY_FOLDER=egabah

# --- Server / Edge only (jangan VITE_*) ---
# Deploy: supabase functions deploy login-alert
# Secret: supabase secrets set RESEND_API_KEY=re_xxx
# RESEND_API_KEY=
